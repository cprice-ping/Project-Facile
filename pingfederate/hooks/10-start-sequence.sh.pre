#!/usr/bin/env sh
echo "Hello from the server profile 10-start-sequence.sh.pre hook!"

OIDC_FILE="/opt/out/instance/bin/oidc.properties"
OBFUSCATE_SCRIPT="/opt/out/instance/bin/obfuscate.sh"

if [ ! -f "$OIDC_FILE" ]; then
  echo "OIDC properties file not found: $OIDC_FILE"
  exit 1
fi

if [ -n "${ADMIN_CLIENT_SECRET:-}" ]; then
  ADMIN_CLIENT_SECRET_CODE="$($OBFUSCATE_SCRIPT "$ADMIN_CLIENT_SECRET" | tr -d ' \t\n\r')"

  if [ -z "$ADMIN_CLIENT_SECRET_CODE" ]; then
    echo "Failed to obfuscate ADMIN_CLIENT_SECRET"
    exit 1
  fi

  ESCAPED_SECRET="$(printf '%s' "$ADMIN_CLIENT_SECRET_CODE" | sed 's/[\\/&]/\\\\&/g')"

  sed -E "s#^client\.secret=.*#client.secret=${ESCAPED_SECRET}#" \
    "$OIDC_FILE" > "${OIDC_FILE}.modified" &&
  mv "${OIDC_FILE}.modified" "$OIDC_FILE"

  echo "Updated client.secret in $OIDC_FILE"
else
  echo "ADMIN_CLIENT_SECRET not set; leaving client.secret unchanged"
fi
